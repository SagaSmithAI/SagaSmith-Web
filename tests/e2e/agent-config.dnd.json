{
  "providers": {
    "openai": {
      "apiKey": "e2e-only-key",
      "apiBase": "http://mock-llm:18080/v1",
      "apiType": "chat_completions"
    }
  },
  "modelPresets": {
    "hosted": {
      "provider": "openai",
      "model": "sagasmith-e2e"
    },
    "module": {
      "provider": "openai",
      "model": "sagasmith-e2e"
    }
  },
  "agents": {
    "defaults": {
      "modelPreset": "hosted",
      "externalSkillsDirs": [
        "/opt/sagasmith/skills/hosted",
        "/opt/sagasmith/skills/dnd/hosted",
        "/opt/sagasmith/skills/dnd-module-generator"
      ]
    }
  },
  "api": {
    "apiKey": "e2e-internal-agent-key"
  },
  "tools": {
    "distribution": "hosted",
    "mcpServers": {
      "sagasmith-dnd-mcp": {
        "type": "streamableHttp",
        "url": "http://dnd-mcp:8767/mcp",
        "injectPrincipal": true,
        "delegationSecret": "e2e-auth-context-secret-at-least-32-bytes",
        "targetService": "sagasmith-dnd-mcp",
        "authorizationAudience": "sagasmith-dnd-mcp",
        "systemIds": [
          "dnd5e"
        ],
        "protocolMode": "2026-07-28",
        "toolTimeout": 900,
        "taskTimeout": 900,
        "exposeResourcesAndPrompts": true,
        "enabledTools": [
          "*"
        ]
      }
    }
  }
}
