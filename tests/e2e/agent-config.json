{
  "providers": {
    "openai": {
      "apiKey": "e2e-only-key",
      "apiBase": "http://mock-llm:18080/v1",
      "apiType": "chat_completions"
    }
  },
  "modelPresets": {
    "hosted": { "provider": "openai", "model": "sagasmith-e2e" }
  },
  "agents": {
    "defaults": {
      "modelPreset": "hosted",
      "externalSkillsDirs": [
        "/opt/sagasmith/skills/hosted",
        "/opt/sagasmith/skills/dnd/full/skills",
        "/opt/sagasmith/skills/dnd-module-generator",
        "/opt/sagasmith/skills/coc/full/skills",
        "/opt/sagasmith/skills/coc-module-generator",
        "/opt/sagasmith/skills/narrative"
      ]
    }
  },
  "api": {
    "apiKey": "e2e-internal-agent-key"
  },
  "tools": {
    "distribution": "hosted",
    "mcpServers": {
      "sagasmith_dnd": {
        "type": "streamableHttp",
        "url": "http://dnd-mcp:8767/mcp",
        "injectPrincipal": true,
        "authContextSecret": "e2e-auth-context-secret-at-least-32-bytes",
        "sessionScoped": true,
        "toolTimeout": 900,
        "exposeResourcesAndPrompts": true,
        "enabledTools": ["*"]
      },
      "sagasmith_coc": {
        "type": "streamableHttp",
        "url": "http://coc-mcp:8768/mcp",
        "injectPrincipal": true,
        "authContextSecret": "e2e-auth-context-secret-at-least-32-bytes",
        "sessionScoped": true,
        "toolTimeout": 900,
        "exposeResourcesAndPrompts": true,
        "enabledTools": ["*"]
      },
      "sagasmith_narrative": {
        "type": "stdio",
        "command": "/build/sagasmith-narrative/.venv/bin/python",
        "args": ["-m", "sagasmith_narrative_mcp.server"],
        "cwd": "/build/sagasmith-narrative",
        "env": {
          "SAGASMITH_NARRATIVE_MCP_HOME": "/workspaces/narrative-state",
          "SAGASMITH_NARRATIVE_SKILLS_DIR": "/opt/sagasmith/skills/narrative",
          "SAGASMITH_AUTH_CONTEXT_SECRET": "e2e-auth-context-secret-at-least-32-bytes"
        },
        "injectPrincipal": true,
        "authContextSecret": "e2e-auth-context-secret-at-least-32-bytes",
        "sessionScoped": true,
        "toolTimeout": 900,
        "exposeResourcesAndPrompts": true,
        "enabledTools": ["*"]
      }
    }
  }
}
