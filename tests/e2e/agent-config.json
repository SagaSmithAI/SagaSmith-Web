{
  "providers": {
    "openai": {
      "apiKey": "e2e-only-key",
      "apiBase": "http://mock-llm:18080/v1",
      "apiType": "chat_completions"
    }
  },
  "modelPresets": {
    "hosted": { "provider": "openai", "model": "sagasmith-e2e" }
  },
  "agents": {
    "defaults": { "modelPreset": "hosted" }
  },
  "api": {
    "apiKey": "e2e-internal-agent-key"
  },
  "tools": {
    "mcpServers": {
      "sagasmith_dnd": {
        "type": "streamableHttp",
        "url": "http://dnd-mcp:8767/mcp",
        "injectPrincipal": true,
        "enabledTools": ["*"]
      }
    }
  }
}
