SAGASMITH_ENV=production
POSTGRES_PASSWORD=replace-with-database-password
MINIO_ROOT_PASSWORD=replace-with-object-storage-password
SAGASMITH_DATABASE_URL=postgresql+psycopg://sagasmith:replace-with-database-password@postgres:5432/sagasmith_service
SAGASMITH_REDIS_URL=redis://redis:6379/0
SAGASMITH_RATE_LIMIT_BACKEND=redis
SAGASMITH_AUTH_RATE_LIMIT=10
SAGASMITH_AUTH_RATE_WINDOW_SECONDS=60
SAGASMITH_AGENT_RATE_LIMIT=60
SAGASMITH_PACK_RATE_LIMIT=10
SAGASMITH_MODULE_RATE_LIMIT=60
SAGASMITH_SESSION_SECRET=replace-with-at-least-32-random-characters
SAGASMITH_PUBLIC_ORIGIN=https://sagasmith.example.com
SAGASMITH_DND_MCP_URL=http://dnd-mcp:8767/mcp
SAGASMITH_AGENT_API_URL=http://agent:8910
SAGASMITH_AGENT_API_KEY=replace-with-agent-internal-key
SAGASMITH_AGENT_COMPLETION_TIMEOUT_SECONDS=900
SAGASMITH_MODULE_AGENT_RESERVATION_TOKENS=131072
SAGASMITH_MODULE_WORKER_CONCURRENCY=2
SAGASMITH_MODULE_WORKER_METRICS_PORT=9101
SAGASMITH_MAX_MODULE_SOURCE_BYTES=104857600
SAGASMITH_STORAGE_BACKEND=s3
SAGASMITH_EXCHANGE_DIR=/srv/sagasmith/exchange
SAGASMITH_MAX_PACK_UNCOMPRESSED_BYTES=2147483648
SAGASMITH_OBJECT_ENDPOINT=http://minio:9000
SAGASMITH_OBJECT_BUCKET=sagasmith-private
SAGASMITH_OBJECT_ACCESS_KEY=sagasmith
SAGASMITH_OBJECT_SECRET_KEY=replace-me
SAGASMITH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SAGASMITH_SECURE_COOKIES=true
SAGASMITH_SITE_ADDRESS=sagasmith.example.com
OPENAI_API_KEY=
SAGASMITH_AGENT_INTERNAL_KEY=replace-with-agent-internal-key
# Audited immutable component revisions. Update with scripts/audit_components.py.
SAGASMITH_CORE_CONTEXT=https://github.com/SagaSmithAI/sagasmith-core.git#028cf19391279953ed353def04f0b2dbf918dbbc
SAGASMITH_DND_CONTEXT=https://github.com/SagaSmithAI/sagasmith-dnd.git#346ec293442171c4ae80272c6b4e9d30b608d0a3
SAGASMITH_DND_MCP_CONTEXT=https://github.com/SagaSmithAI/SagaSmith-dnd-mcp.git#2219d18aee53014adb7cb4b768313d6aa033cf28
SAGASMITH_DND_SKILLS_CONTEXT=https://github.com/SagaSmithAI/SagaSmith-dnd-skills.git#1e44c39b36e5802337c9ed0f76d6f9e0b0549729
SAGASMITH_AGENT_CONTEXT=https://github.com/SagaSmithAI/SagaSmith-agent.git#211782e99269f10cb3dcfed2f5ce26bfd0be2330
SAGASMITH_MODULE_GEN_SKILLS_CONTEXT=https://github.com/SagaSmithAI/SagaSmith-module-gen-skills.git#6a6261f52a88dab7bb360df6dbfcd1443b500bbd
