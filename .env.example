SAGASMITH_ENV=development
POSTGRES_PASSWORD=replace-with-database-password
MINIO_ROOT_PASSWORD=replace-with-object-storage-password
SAGASMITH_DATABASE_URL=postgresql+psycopg://sagasmith:replace-with-database-password@postgres:5432/sagasmith_service
SAGASMITH_REDIS_URL=redis://redis:6379/0
SAGASMITH_SESSION_SECRET=replace-with-at-least-32-random-characters
SAGASMITH_PUBLIC_ORIGIN=http://127.0.0.1:8080
SAGASMITH_DND_MCP_URL=http://dnd-mcp:8767/mcp
SAGASMITH_DND_MCP_SERVICE_PRINCIPAL=service:sagasmith
SAGASMITH_AGENT_API_URL=http://agent:8910
SAGASMITH_AGENT_API_KEY=replace-with-agent-internal-key
SAGASMITH_STORAGE_BACKEND=s3
SAGASMITH_EXCHANGE_DIR=/srv/sagasmith/exchange
SAGASMITH_OBJECT_ENDPOINT=http://minio:9000
SAGASMITH_OBJECT_BUCKET=sagasmith-private
SAGASMITH_OBJECT_ACCESS_KEY=sagasmith
SAGASMITH_OBJECT_SECRET_KEY=replace-me
SAGASMITH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SAGASMITH_SECURE_COOKIES=false
SAGASMITH_SITE_ADDRESS=:80
OPENAI_API_KEY=
SAGASMITH_AGENT_INTERNAL_KEY=replace-with-agent-internal-key
# Production releases must replace #main with reviewed tags or commit SHAs.
SAGASMITH_CORE_CONTEXT=https://github.com/SagaSmithAI/sagasmith-core.git#main
SAGASMITH_DND_CONTEXT=https://github.com/SagaSmithAI/sagasmith-dnd.git#main
SAGASMITH_DND_MCP_CONTEXT=https://github.com/SagaSmithAI/SagaSmith-dnd-mcp.git#main
SAGASMITH_DND_SKILLS_CONTEXT=https://github.com/SagaSmithAI/SagaSmith-dnd-skills.git#main
SAGASMITH_AGENT_CONTEXT=https://github.com/SagaSmithAI/SagaSmith-agent.git#main
