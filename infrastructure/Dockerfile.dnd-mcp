FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagic1 poppler-utils tesseract-ocr && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY --from=core . ./sagasmith-core
COPY --from=dnd . ./sagasmith-dnd
COPY --from=dnd_mcp . ./SagaSmith-dnd-mcp
COPY --from=dnd_skills . ./SagaSmith-dnd-skills
RUN pip install "/build/sagasmith-core[documents]" \
    "/build/sagasmith-dnd[documents,images]" "/build/SagaSmith-dnd-mcp"
RUN useradd -m -u 10001 sagasmith && mkdir -p /state /srv/sagasmith/exchange && \
    chown -R sagasmith:sagasmith /state /srv/sagasmith
USER sagasmith
EXPOSE 8767
CMD ["sagasmith-dnd-mcp"]
