FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagic1 poppler-utils tesseract-ocr && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY --from=core . ./sagasmith-core
COPY --from=coc . ./sagasmith-coc
COPY --from=coc_mcp . ./SagaSmith-coc-mcp
COPY --from=coc_skills . ./SagaSmith-coc-skills
COPY --from=module_gen_skills . ./SagaSmith-module-gen-skills
RUN pip install --no-cache-dir uv==0.11.25 && \
    cd /build/SagaSmith-coc-mcp && uv sync --frozen --no-dev
RUN useradd -m -u 10003 sagasmith && mkdir -p /state /srv/sagasmith/exchange && \
    chown -R sagasmith:sagasmith /state /srv/sagasmith
USER sagasmith
ENV PATH="/build/SagaSmith-coc-mcp/.venv/bin:$PATH"
EXPOSE 8768
CMD ["sagasmith-coc-mcp"]
