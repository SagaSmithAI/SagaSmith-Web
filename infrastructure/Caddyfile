{$SAGASMITH_SITE_ADDRESS::80} {
	encode zstd gzip
	# Prometheus scrapes the API over the private Compose network. Never expose
	# process, dependency, or capacity metrics through the public edge.
	@private_metrics path /metrics
	respond @private_metrics 404
	reverse_proxy api:8080
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		-Server
	}
}
