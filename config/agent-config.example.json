{
  "providers": {
    "openai": { "apiKey": "${OPENAI_API_KEY}" }
  },
  "modelPresets": {
    "hosted": { "provider": "openai", "model": "gpt-5.4-mini" }
  },
  "agents": {
    "defaults": {
      "modelPreset": "hosted",
      "externalSkillsDirs": [
        "/opt/sagasmith/skills/hosted",
        "/opt/sagasmith/skills/dnd/full/skills",
        "/opt/sagasmith/skills/dnd-module-generator",
        "/opt/sagasmith/skills/coc/full/skills",
        "/opt/sagasmith/skills/coc-module-generator",
        "/opt/sagasmith/skills/narrative"
      ]
    }
  },
  "api": {
    "apiKey": "${SAGASMITH_AGENT_INTERNAL_KEY}"
  },
  "tools": {
    "distribution": "hosted",
    "mcpServers": {
      "sagasmith-dnd-mcp": {
        "type": "streamableHttp",
        "url": "http://dnd-mcp:8767/mcp",
        "injectPrincipal": true,
        "authContextSecret": "${SAGASMITH_AUTH_CONTEXT_SECRET}",
        "sessionScoped": true,
        "toolTimeout": 900,
        "exposeResourcesAndPrompts": true,
        "enabledTools": ["*"]
      },
      "sagasmith-coc-mcp": {
        "type": "streamableHttp",
        "url": "http://coc-mcp:8768/mcp",
        "injectPrincipal": true,
        "authContextSecret": "${SAGASMITH_AUTH_CONTEXT_SECRET}",
        "sessionScoped": true,
        "toolTimeout": 900,
        "exposeResourcesAndPrompts": true,
        "enabledTools": ["*"]
      },
      "sagasmith-narrative-mcp": {
        "type": "stdio",
        "command": "/build/sagasmith-narrative/.venv/bin/python",
        "args": ["-m", "sagasmith_narrative_mcp.server"],
        "cwd": "/build/sagasmith-narrative",
        "env": {
          "SAGASMITH_NARRATIVE_MCP_HOME": "/workspaces/narrative-state",
          "SAGASMITH_NARRATIVE_SKILLS_DIR": "/opt/sagasmith/skills/narrative",
          "SAGASMITH_AUTH_CONTEXT_SECRET": "${SAGASMITH_AUTH_CONTEXT_SECRET}"
        },
        "injectPrincipal": true,
        "authContextSecret": "${SAGASMITH_AUTH_CONTEXT_SECRET}",
        "sessionScoped": true,
        "toolTimeout": 900,
        "exposeResourcesAndPrompts": true,
        "enabledTools": ["*"]
      }
    }
  }
}
