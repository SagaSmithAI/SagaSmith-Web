# Copy to .env.production and fill every replace-* value from the deployment
# secret store. Never commit the copied file.
SAGASMITH_ENV=production
SAGASMITH_PUBLIC_ORIGIN=
SAGASMITH_SITE_ADDRESS=
SAGASMITH_REGISTRATION_MODE=invite
SAGASMITH_SIGNUP_TOKEN_QUOTA=0

# Three immutable DND release images. Tags and floating references are rejected by
# scripts/production_preflight.py.
SAGASMITH_WEB_IMAGE=ghcr.io/sagasmithai/sagasmith-web@sha256:replace-with-64-hex-digest
SAGASMITH_AGENT_IMAGE=ghcr.io/sagasmithai/sagasmith-web-agent@sha256:replace-with-64-hex-digest
SAGASMITH_DND_IMAGE=ghcr.io/sagasmithai/sagasmith-web-dnd-mcp@sha256:replace-with-64-hex-digest

POSTGRES_PASSWORD=replace-with-database-password
SAGASMITH_DATABASE_URL=postgresql+psycopg://sagasmith:replace-with-database-password@postgres:5432/sagasmith_service
SAGASMITH_REDIS_URL=redis://redis:6379/0
SAGASMITH_RATE_LIMIT_BACKEND=redis
SAGASMITH_SESSION_SECRET=replace-with-at-least-32-random-characters
SAGASMITH_AGENT_API_KEY=replace-with-at-least-32-random-characters
SAGASMITH_AGENT_INTERNAL_KEY=replace-with-at-least-32-random-characters
SAGASMITH_WORKER_SERVICE_TOKEN=replace-with-at-least-32-random-characters
SAGASMITH_AUTH_CONTEXT_SECRET=replace-with-at-least-32-random-characters

# DigitalOcean Spaces S3-compatible endpoint; create the private bucket before
# deployment and keep bucket creation disabled in production.
SAGASMITH_STORAGE_BACKEND=s3
SAGASMITH_OBJECT_ENDPOINT=https://sgp1.digitaloceanspaces.com
SAGASMITH_OBJECT_REGION=sgp1
SAGASMITH_OBJECT_BUCKET=replace-with-private-spaces-bucket
SAGASMITH_OBJECT_ACCESS_KEY=replace-with-spaces-key
SAGASMITH_OBJECT_SECRET_KEY=replace-with-spaces-secret
SAGASMITH_OBJECT_CREATE_BUCKET=false

# Fill with reviewed, versioned rates for the exact provider/model. Do not put
# illustrative or guessed prices here; production startup rejects this marker.
SAGASMITH_PROVIDER_BUDGET_ENABLED=true
SAGASMITH_PROVIDER_PRICES=replace-with-reviewed-versioned-provider-prices-json
SAGASMITH_TASK_BUDGET_USD=replace-with-reviewed-task-budget-usd

SAGASMITH_AGENT_BOUNDARY_MODE=modern
SAGASMITH_AGENT_COMPLETION_TIMEOUT_SECONDS=900
SAGASMITH_AGENT_RESERVATION_TTL_SECONDS=1200
SAGASMITH_AGENT_DELEGATION_TTL_SECONDS=600
SAGASMITH_AGENT_MAX_WORKERS=6
SAGASMITH_AGENT_SPAWN_CONCURRENCY=1
SAGASMITH_ROOM_TURN_WORKER_CONCURRENCY=2
SAGASMITH_ROOM_TURN_PER_ROOM_CONCURRENCY=1
SAGASMITH_MODULE_WORKER_CONCURRENCY=1
SAGASMITH_MODULE_WORKER_IO_CONCURRENCY=1
SAGASMITH_MAX_PACK_BYTES=67108864
SAGASMITH_MAX_MODULE_SOURCE_BYTES=33554432
SAGASMITH_ROOM_TURN_MEDIA_MAX_BYTES=8388608
SAGASMITH_USER_UPLOAD_STORAGE_BYTES=536870912

SAGASMITH_ENABLED_SYSTEMS=["dnd5e"]
SAGASMITH_MODEL_PROFILE=dnd-flash
DEEPSEEK_API_KEY=
